# Water: wB97X-D/def2-SVP optimization + harmonic frequencies (QuantaBench cclib test fixture)
memory 500 mb

# Work around pint 0.26 vs qcelemental 0.30 in this environment: skip unit definitions pint cannot parse
import pint
_qb_define = pint.UnitRegistry.define
def _qb_safe_define(self, definition):
    try:
        return _qb_define(self, definition)
    except TypeError:
        return None
pint.UnitRegistry.define = _qb_safe_define

molecule water {
0 1
O    0.000000    0.000000    0.117300
H    0.000000    0.757200   -0.469200
H    0.000000   -0.757200   -0.469200
}

set {
  basis def2-SVP
  scf_type df
  e_convergence 1e-8
  d_convergence 1e-8
}

e, wfn = optimize('wb97x-d', return_wfn=True)
e, wfn = frequency('wb97x-d', molecule=water, return_wfn=True)
